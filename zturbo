        for s in "${SELECTED_PATHS[@]}"; do
            fname=$(basename "$s")
            if [[ "$IS_REMOTE" == true ]]; then S_ARG="$REMOTE_STR:\"$s\""; else S_ARG="\"$s\""; fi
            
