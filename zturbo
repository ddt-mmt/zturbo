# --- ROBUST WRAPPERS ---
# Retry logic prevents failures on network glitches (Router Safety)

run_rsync_retry() {
    local cmd="$1"
    local desc="$2"
    local max_retries=3
    local attempt=1
    
    while [[ $attempt -le $max_retries ]]; do
        if [[ $attempt -gt 1 ]]; then 
            echo "   ⚠️  Retry $attempt/$max_retries for: $desc..." | tee -a "$REPORT_TXT"
            sleep 3
        fi
        
        # Execute Command and check status
        echo ">> Executing: $desc" | tee -a "$REPORT_TXT"
        eval "$cmd"
        status=$?
        
        if [[ $status -eq 0 ]]; then
            return 0
        fi
        
        echo "   ❌ Error (Code $status) on: $desc" | tee -a "$REPORT_TXT"
        ((attempt++))
    done
    return 1
}

