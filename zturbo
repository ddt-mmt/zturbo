}

show_footer() {
    echo -e "\n${BOLD_CYAN}------------------------------------------${NC}"
    echo -e "$1"
    echo -e "${BOLD_CYAN}------------------------------------------${NC}"
    echo -n " 👉 INPUT > "
}

format_duration() { printf "%02dh:%02dm:%02ds" $(($1/3600)) $(($(( $1%3600 ))/60)) $(($1%60)); }
human_size() { numfmt --to=iec-i --suffix=B $1 2>/dev/null || echo "$1 B"; }

# --- DATA STRUCTURES ---
# Using Associative Array for O(1) lookup
declare -A SELECTED_MAP
declare -a SELECTED_PATHS

# --- 1. SOURCE MODULE (PAGINATED) ---

select_remote_source() {
    print_header
    echo -e "${BOLD_YELLOW}[ REMOTE SSH CONFIG ]${NC}"
    echo -e "Enter Remote User & IP (e.g. root@10.28.1.15)"
    read -e -p " 👉 REMOTE > " r_conn
    if [[ -z "$r_conn" ]]; then return 1; fi
    
    echo -e "\nEnter Remote Base Path (e.g. /mnt/MainPool)"
    read -e -p " 👉 PATH   > " r_path
    if [[ -z "$r_path" ]]; then r_path="/mnt"; fi

    echo -e "\n${BOLD_CYAN}Testing connection to $r_conn...${NC}"
    # Quick SSH check
    if ssh -q -o ConnectTimeout=5 -o BatchMode=yes "$r_conn" exit; then
        echo -e "${BOLD_GREEN}Connected!${NC}"
        REMOTE_STR="$r_conn"
        IS_REMOTE=true
        SELECTED_PATHS=("$r_path")
        return 0
    else
        echo -e "${BOLD_RED}Connection Failed!${NC} (Check SSH keys or IP)"
        sleep 2
        return 1
    fi
}

select_source() {
    while true; do
        IS_REMOTE=false
        REMOTE_STR=""
        print_header
        echo -e "${BOLD_YELLOW}[ STEP 1 ] SELECT SOURCE LOCATION${NC}"
        
        # Mounts listing
        mapfile -t mounts < <(mount | grep -E "type cifs|type nfs|type gpfs|type smb|on /mnt|on /media" | awk '{print $3 "|" $1}')
        echo -e " [0] 🏠 HOME DIRECTORY ($HOME)"
        echo -e " [1] 🌳 ROOT DIRECTORY (/)"
        echo -e " [R] 🌐 REMOTE SSH (TrueNAS/Direct)"
        i=2
        for line in "${mounts[@]}"; do
            path=$(echo "$line" | cut -d'|' -f1)
            src=$(echo "$line" | cut -d'|' -f2)
            echo -e " [$i] 📂 ${BOLD_MAGENTA}$path${NC}"
            echo -e "     └─ 🔗 Source: ${GREY}$src${NC}"
            ((i++))
        done
        show_footer "[#] Select | [R] Remote | [Q] Quit"
        read -e pil || exit 1
        
        if [[ "${pil^^}" == "Q" ]]; then exit 0; fi
        if [[ "${pil^^}" == "R" ]]; then 
            if select_remote_source; then return 0; fi
            continue
        fi
        
        if [[ "$pil" == "0" ]]; then NAV_PATH="$HOME"
        elif [[ "$pil" == "1" ]]; then NAV_PATH="/"
        elif [[ "$pil" =~ ^[0-9]+$ ]] && [[ "$pil" -lt "$i" ]]; then
             idx=$((pil-2)); l="${mounts[$idx]}"; NAV_PATH=$(echo "$l" | cut -d'|' -f1)
        else 
             echo "Invalid Choice!"; sleep 1; continue
        fi

        MOUNT_ROOT="$NAV_PATH"
        BREAK_SRC=false; PAGE=1; PER_PAGE=15
        
        while true; do
            print_header
            echo -e "${BOLD_YELLOW}[ BROWSE SOURCE ]${NC} ${BOLD_WHITE}$NAV_PATH${NC}"
            
            SEL_COUNT=${#SELECTED_MAP[@]}
            if [[ $SEL_COUNT -gt 0 ]]; then
                echo -e "${BOLD_GREEN}✅ Selected Items: $SEL_COUNT${NC} (Type 'D' to Finalize)"
            else
                echo -e "${GREY}   No items selected yet.${NC}"
            fi

            mapfile -t contents < <(\ls -1 -A --group-directories-first --color=never "$NAV_PATH" 2>/dev/null)
            total_items=${#contents[@]}
            
            total_pages=$(( (total_items + PER_PAGE - 1) / PER_PAGE ))
            [ $total_pages -eq 0 ] && total_pages=1
            [ $PAGE -gt $total_pages ] && PAGE=$total_pages
            [ $PAGE -lt 1 ] && PAGE=1
            start_idx=$(( (PAGE - 1) * PER_PAGE ))
            
            echo -e " ----------------------------------------"
            echo -e " PAGE $PAGE of $total_pages | Total Items: $total_items"
            echo -e " ----------------------------------------"
            
            if [[ "$PAGE" -eq 1 ]]; then
                 echo -e " [0] ✅ DONE / SELECT CURRENT FOLDER"
            fi

            display_count=1
            curr_idx=$start_idx
            
            # Display loop
            for (( i=0; i<PER_PAGE; i++ )); do
                idx=$(( start_idx + i ))
                if [[ $idx -ge $total_items ]]; then break; fi
                
                item="${contents[$idx]}"
                fp="${NAV_PATH%/}/$item"
                
                # Check Selection Map (O(1))
                if [[ -n "${SELECTED_MAP["$fp"]}" ]]; then
                    MARK="[${BOLD_GREEN}*${NC}]"
                else
                    MARK="[ ]"
                fi
                
                # Get Size (Only for displayed items to keep it fast)
                # Use timeout to prevent hang on stale network mounts
                item_size=$(timeout 0.1 du -sh "$fp" 2>/dev/null | awk '{print $1}')
                [ -z "$item_size" ] && item_size="?"

                rel_num=$(( i + 1 ))
                
                if [[ -d "$fp" ]]; then
                    printf " %s [%2d] 📁 ${BOLD_CYAN}%-30s${NC} ${BOLD_YELLOW}(%s)${NC}\n" "$MARK" "$rel_num" "$item/" "$item_size"
                else
                    printf " %s [%2d] 📄 %-30s ${GREY}(%s)${NC}\n" "$MARK" "$rel_num" "$item" "$item_size"
                fi
                display_count=$((display_count+1))
            done
            
            # Navigation Menu Construction
            NAV_MENU=""
            if [[ $PAGE -lt $total_pages ]]; then NAV_MENU+="[N] Next | "; fi
            if [[ $PAGE -gt 1 ]]; then NAV_MENU+="[P] Prev | "; fi
            if [[ "$NAV_PATH" == "$MOUNT_ROOT" ]] || [[ "$NAV_PATH" == "/" ]]; then BACK_MSG="Main Menu"; else BACK_MSG="Up (..)"; fi
            
            show_footer "${NAV_MENU}[#] Enter/Toggle | [S #] Select Folder | [A] All | [C] Clear | [D] Done | [B] $BACK_MSG"
            read -e inp || exit 1
            
            INP_UP="${inp^^}"
            
            # Logic Actions
            if [[ "$INP_UP" == "Q" ]]; then exit 0; fi
            if [[ "$INP_UP" == "D" ]] || [[ "$inp" == "0" ]]; then
                if [[ ${#SELECTED_MAP[@]} -eq 0 ]]; then
                     # If nothing selected, select current folder
                     SELECTED_MAP["$NAV_PATH"]=1
                fi
                BREAK_SRC=true; break
            fi
            
            if [[ "$INP_UP" == "B" ]]; then
                if [[ "$NAV_PATH" == "$MOUNT_ROOT" ]] || [[ "$NAV_PATH" == "/" ]]; then break
                else NAV_PATH=$(dirname "$NAV_PATH"); PAGE=1; continue; fi
            fi
            
            if [[ "$INP_UP" == "N" ]]; then
                if [[ $PAGE -lt $total_pages ]]; then PAGE=$((PAGE+1)); fi; continue
            fi
            if [[ "$INP_UP" == "P" ]]; then
                if [[ $PAGE -gt 1 ]]; then PAGE=$((PAGE-1)); fi; continue
            fi
            
            # Select All in View (or All in Folder? Lets do All in Folder for convenience)
            if [[ "$INP_UP" == "A" ]]; then
                 echo "Selecting all items..."
                 for item in "${contents[@]}"; do
                    full_p="${NAV_PATH%/}/$item"
                    SELECTED_MAP["$full_p"]=1
                 done
                 continue
            fi
            
            if [[ "$INP_UP" == "C" ]]; then
                SELECTED_MAP=()
                continue
            fi

            # Toggle Logic: "S <num>" or just "s<num>"
            # Useful for selecting Directories without entering them
            if [[ "$inp" =~ ^[sS][[:space:]]*([0-9]+)$ ]]; then
                num="${BASH_REMATCH[1]}"
                if [[ "$num" -gt 0 ]] && [[ "$num" -le "$PER_PAGE" ]]; then
                     abs_idx=$(( start_idx + num - 1 ))
                     if [[ $abs_idx -lt $total_items ]]; then
                         item="${contents[$abs_idx]}"
                         target="${NAV_PATH%/}/$item"
                         
                         if [[ -n "${SELECTED_MAP["$target"]}" ]]; then
                             unset SELECTED_MAP["$target"]
                         else
                             SELECTED_MAP["$target"]=1
                         fi
                     fi
                fi
                continue
            fi
            
            # Navigation Logic: Just number
            # IMPROVEMENT: If file, Toggle it. If folder, Enter it.
            if [[ "$inp" =~ ^[0-9]+$ ]]; then
                num=$inp
                if [[ "$num" -gt 0 ]] && [[ "$num" -le "$PER_PAGE" ]]; then
                    abs_idx=$(( start_idx + num - 1 ))
                    if [[ $abs_idx -lt $total_items ]]; then
                        sel="${contents[$abs_idx]}"
                        target="${NAV_PATH%/}/$sel"
                        
                        if [[ -d "$target" ]]; then
                            # It is a directory -> Enter it
                            NAV_PATH="$target"
                            PAGE=1 # Reset page on enter
                        else
                            # It is a file -> Toggle selection (Smart UX)
                            if [[ -n "${SELECTED_MAP["$target"]}" ]]; then
                                unset SELECTED_MAP["$target"]
                            else
                                SELECTED_MAP["$target"]=1
                            fi
                        fi
                    fi
                fi
            fi
        done
        
        if [[ "$BREAK_SRC" == true ]]; then 
            # Convert Map to Array for Main Logic
            SELECTED_PATHS=()
            for key in "${!SELECTED_MAP[@]}"; do
                SELECTED_PATHS+=("$key")
            done
            return 0
        fi
    done
}

# --- 2. DESTINATION MODULE ---
select_dest() {
    while true; do
        print_header
        echo -e "${BOLD_YELLOW}[ STEP 2 ] SELECT DESTINATION${NC}"
        # Brief Summary
        count=${#SELECTED_PATHS[@]}
        if [[ $count -gt 0 ]]; then
             echo -e "Source: ${BOLD_CYAN}${SELECTED_PATHS[0]}${NC} $([ $count -gt 1 ] && echo "+ $((count-1)) more")"
        fi
        echo -e "------------------------------------------"
        
        mapfile -t mounts < <(mount | grep -E "type cifs|type nfs|type gpfs|type smb|on /mnt|on /media" | awk '{print $3 "|" $1}')
        echo -e " [0] 🏠 HOME DIR ($HOME)"
        echo -e " [1] 🌳 ROOT DIR (/)"
        i=2
        for line in "${mounts[@]}"; do
            path=$(echo "$line" | cut -d'|' -f1)
            src=$(echo "$line" | cut -d'|' -f2)
            echo -e " [$i] 📂 ${BOLD_MAGENTA}$path${NC}"
            echo -e "     └─ 🔗 Source: ${GREY}$src${NC}"
            ((i++))
        done
        show_footer "[#] Select | [R] Refresh | [B] Back"
        read -e pil || exit 1
        
        if [[ "${pil^^}" == "Q" ]]; then exit 0; fi
        if [[ "${pil^^}" == "B" ]]; then return 1; fi
        if [[ "${pil^^}" == "R" ]]; then continue; fi
        
        if [[ "$pil" == "0" ]]; then NAV_PATH="$HOME"
elif [[ "$pil" == "1" ]]; then NAV_PATH="/"
elif [[ "$pil" =~ ^[0-9]+$ ]] && [[ "$pil" -lt "$i" ]]; then 
            idx=$((pil-2)); l="${mounts[$idx]}"; NAV_PATH=$(echo "$l" | cut -d'|' -f1)
        else echo "Invalid!"; sleep 1; continue; fi

        MOUNT_ROOT="$NAV_PATH"
        BREAK_DEST=false
        PAGE=1
        PER_PAGE=15

        while true; do
            print_header
            echo -e "${BOLD_YELLOW}[ BROWSE DESTINATION ]${NC} ${BOLD_WHITE}$NAV_PATH${NC}"
            
            mapfile -t contents < <(\ls -1 -A --group-directories-first --color=never "$NAV_PATH" 2>/dev/null)
            total_items=${#contents[@]}

            # Pagination Logic
            total_pages=$(( (total_items + PER_PAGE - 1) / PER_PAGE ))
            [ $total_pages -eq 0 ] && total_pages=1
            [ $PAGE -gt $total_pages ] && PAGE=$total_pages
            [ $PAGE -lt 1 ] && PAGE=1
            
            start_idx=$(( (PAGE - 1) * PER_PAGE ))

            echo -e " ----------------------------------------"
            echo -e " PAGE $PAGE of $total_pages | [0] ✅ SELECT CURRENT FOLDER"
            echo -e " ----------------------------------------"

            for (( i=0; i<PER_PAGE; i++ )); do
                idx=$(( start_idx + i ))
                if [[ $idx -ge $total_items ]]; then break; fi
                
                item="${contents[$idx]}"
                fp="${NAV_PATH%/}/$item"
                rel_num=$(( i + 1 ))

                if [[ -d "$fp" ]]; then 
                    echo -e " [$rel_num] 📁 ${BOLD_CYAN}$item/${NC}"
                else
                    echo -e " [$rel_num] 📄 $item"
                fi
            done
            
            NAV_MENU=""
            if [[ $PAGE -lt $total_pages ]]; then NAV_MENU+="[N] Next | "; fi
            if [[ $PAGE -gt 1 ]]; then NAV_MENU+="[P] Prev | "; fi
            if [[ "$NAV_PATH" == "$MOUNT_ROOT" ]] || [[ "$NAV_PATH" == "/" ]]; then BACK_MSG="Main Menu"; else BACK_MSG="Up (..)"; fi
            
            show_footer "${NAV_MENU}[#] Enter | [MK] New Folder | [0] Select | [B] $BACK_MSG"
            read -e inp || exit 1
            INP_UP="${inp^^}"
            
            if [[ "$INP_UP" == "B" ]]; then 
                if [[ "$NAV_PATH" == "$MOUNT_ROOT" ]] || [[ "$NAV_PATH" == "/" ]]; then break; else NAV_PATH=$(dirname "$NAV_PATH"); PAGE=1; continue; fi
            fi
            
            if [[ "$inp" == "0" ]]; then DEST_ROOT="$NAV_PATH"; BREAK_DEST=true; break; fi
            if [[ "$INP_UP" == "MK" ]]; then read -e -p "New Folder Name: " new_f; mkdir -p "$NAV_PATH/$new_f"; continue; fi
            
            if [[ "$INP_UP" == "N" ]]; then if [[ $PAGE -lt $total_pages ]]; then PAGE=$((PAGE+1)); fi; continue; fi
            if [[ "$INP_UP" == "P" ]]; then if [[ $PAGE -gt 1 ]]; then PAGE=$((PAGE-1)); fi; continue; fi

            if [[ "$inp" =~ ^[0-9]+$ ]]; then
                num=$inp
                if [[ "$num" -gt 0 ]] && [[ "$num" -le "$PER_PAGE" ]]; then
                    abs_idx=$(( start_idx + num - 1 ))
                    if [[ $abs_idx -lt $total_items ]]; then
                        sel="${contents[$abs_idx]}"
                        target="${NAV_PATH%/}/$sel"
                        if [[ -d "$target" ]]; then NAV_PATH="$target"; PAGE=1
                        else echo -e "${BOLD_RED}Target is not a directory.${NC}"; sleep 1; fi
                    fi
                fi
            fi
        done
        if [[ "$BREAK_DEST" == true ]]; then return 0; fi
    done
}

# --- ADAPTIVE THREADS ---
calc_optimal_threads() {
    local mode="$1"
    local cores=$(nproc)
    local mem_total_mb=$(free -m | grep Mem | awk '{print $2}')
    local mem_usable_mb=$(( mem_total_mb * 80 / 100 )) 
    local max_threads_ram=$(( mem_usable_mb / 60 ))
    [ $max_threads_ram -lt 2 ] && max_threads_ram=2
    
    local target_threads=1
    
    if [[ "$mode" == "SAFE" ]]; then
        target_threads=$(awk -v c="$cores" 'BEGIN {printf "%.0f", c * 0.75}')
        [ $target_threads -lt 1 ] && target_threads=1
    else
        target_threads=$(( cores * 4 ))
        [ $target_threads -gt 24 ] && target_threads=24
    fi
    
    if [[ $target_threads -gt $max_threads_ram ]]; then target_threads=$max_threads_ram; fi
    [ $target_threads -gt 1024 ] && target_threads=1024
    echo "$target_threads"
}

# --- MAIN LOGIC ---
STEP=1

while true; do
    if [[ $STEP -eq 1 ]]; then 
        select_source
        if [[ ${#SELECTED_PATHS[@]} -eq 1 ]]; then 
            SUGGESTED_NAME=$(basename "${SELECTED_PATHS[0]}")
        else 
            SUGGESTED_NAME="Batch_Transfer_$(date +%H%M)"
        fi
        SUB_FOLDER="$SUGGESTED_NAME"
        STEP=2
    fi
    if [[ $STEP -eq 2 ]]; then 
        select_dest
        if [[ $? -eq 1 ]]; then STEP=1; continue; fi
        STEP=3
    fi

                # --- GLOBAL STATE FOR CALC ---
                BG_CALC_PID=""
                NEED_RECALC="true"
                
                # Helper to start calc safely
                start_async_calc() {
                    # Kill previous if running
                    if [[ -n "$BG_CALC_PID" ]] && kill -0 "$BG_CALC_PID" 2>/dev/null; then
                        pkill -P "$BG_CALC_PID" >/dev/null 2>&1
                        kill "$BG_CALC_PID" >/dev/null 2>&1
                    fi
                    
                    rm -f "/tmp/zturbo_sz_res_$$"
                    
                    (
                        TEMP_SIZE=0
                        for s in "${SELECTED_PATHS[@]}"; do
                            if [[ "$IS_REMOTE" == true ]]; then
                                # Remote du over SSH
                                sz=$(ssh "$REMOTE_STR" "timeout 15 du -sb \"$s\"" 2>/dev/null | awk '{print $1}')
                            else
                                # Local du
                                sz=$(timeout 15 du -sb "$s" 2>/dev/null | awk '{print $1}')
                            fi
                            [ -z "$sz" ] && sz=0
                            TEMP_SIZE=$((TEMP_SIZE + sz))
                        done
                        echo "$TEMP_SIZE" > "/tmp/zturbo_sz_res_$$"
                    ) &
                    BG_CALC_PID=$!
                    NEED_RECALC="false"
                }
                        
                            if [[ $STEP -eq 3 ]]; then
                                # Trigger calc on entry if needed
                                if [[ "$NEED_RECALC" == "true" ]]; then
                                    start_async_calc
                                fi
                        
                                while true; do
                                    # Check status for display
                                    if [[ -f "/tmp/zturbo_sz_res_$$" ]]; then
                                        # Finished
                                        TOTAL_SRC_SIZE=$(cat "/tmp/zturbo_sz_res_$$")
                                        HR_SRC=$(numfmt --to=iec $TOTAL_SRC_SIZE 2>/dev/null || echo "?")                            
                            DEST_FREE=$(df -k "$DEST_ROOT" 2>/dev/null | awk 'NR==2 {print $4}')
                            [ -z "$DEST_FREE" ] && DEST_FREE=0
                            HR_FREE=$(numfmt --to=iec --from-unit=1K $DEST_FREE)
                            
                            if [[ "$DEST_FREE" -lt "$TOTAL_SRC_SIZE" ]]; then
                                STATUS_MSG="${BOLD_RED}⚠️ WARNING: INSUFFICIENT DISK SPACE!${NC}"
                            else
                                STATUS_MSG="${BOLD_GREEN}✅ Disk Space OK${NC}"
                            fi
                        elif [[ -n "$BG_CALC_PID" ]] && kill -0 "$BG_CALC_PID" 2>/dev/null; then
                            # Still running
                            HR_SRC="${BOLD_YELLOW}Calculating...${NC}"
                            HR_FREE="-"
                            STATUS_MSG="${BOLD_YELLOW}⏳ Please wait...${NC}"
                        else
                            # Failed/Unknown
                            HR_SRC="Unknown"
                            HR_FREE="-"
                            STATUS_MSG=""
                        fi
            
                        REC_THREADS=$(calc_optimal_threads "$CURRENT_MODE")
                        if [[ -z "$MANUAL_THREADS" ]]; then THREADS=$REC_THREADS; fi
