# --- CONFIG ---
CPU_CORES=$(nproc)
CURRENT_MODE="SAFE" 
FILES_PER_JOB=2500
DASHBOARD_DIR="/tmp/zturbo_dashboard"
REPORT_DIR="/tmp/zturbo_reports"

mkdir -p "$DASHBOARD_DIR" "$REPORT_DIR"
chmod 777 "$DASHBOARD_DIR" "$REPORT_DIR" 2>/dev/null
find "$REPORT_DIR" -type f -name "*.txt" -mtime +7 -delete 2>/dev/null

if [ -n "$SUDO_USER" ]; then REAL_USER="$SUDO_USER"; else REAL_USER="$USER"; fi

JOB_ID="${REAL_USER}_$$"
MONITOR_FILE="$DASHBOARD_DIR/${JOB_ID}.info"
REPORT_TXT="$REPORT_DIR/${REAL_USER}_job$$.txt"
JOB_COMPLETED=false

# --- STYLES ---
BOLD_GREEN='\033[1;32m'; BOLD_YELLOW='\033[1;33m'; BOLD_CYAN='\033[1;36m'
BOLD_MAGENTA='\033[1;35m'; BOLD_WHITE='\033[1;37m'; BOLD_RED='\033[1;31m'
NC='\033[0m'; GREY='\033[0;90m'

# --- DEPENDENCY CHECK ---
check_deps() {
    local deps=("rsync" "fpsync" "du" "find" "grep")
    local missing=()
    for cmd in "${deps[@]}"; do
        if ! command -v "$cmd" &> /dev/null; then
            missing+=("$cmd")
        fi
    done
    
    if [ ${#missing[@]} -ne 0 ]; then
        echo -e "${BOLD_RED}CRITICAL ERROR: Missing dependencies: ${missing[*]}${NC}"
        echo -e "Please install them first (e.g., sudo apt install fpart rsync)"
        exit 1
    fi
}
check_deps

cleanup() {
    rm -f "$MONITOR_FILE"
    rm -f /tmp/dt_src_$$ /tmp/dt_dest_$$ /tmp/zturbo_size_$$ 2>/dev/null
    if [ -n "$GOV_PID" ]; then kill $GOV_PID 2>/dev/null; fi
    if [ "$JOB_COMPLETED" = false ]; then
        if [ -f "$REPORT_TXT" ]; then
            echo -e "\nSTATUS      : CANCELLED/FAILED (Interrupted)" >> "$REPORT_TXT"
            echo "----------------------------------------------------------------" >> "$REPORT_TXT"
        fi
        echo -e "\n${BOLD_RED}❌ Process Interrupted (Ctrl+C). Cleaning up...${NC}"
    fi
}
trap cleanup EXIT
trap "exit 1" INT TERM

# --- DYNAMIC GOVERNOR (AUTO-ADAPTIVE) ---
dynamic_governor() {
    # Only active in TURBO mode to manage high loads
    if [ "$CURRENT_MODE" != "TURBO" ]; then return; fi
    
    local pgid=$(ps -o pgid= -p $$ | xargs)
    local state="NORMAL"
    
    while true; do
        # Get Load Average (1 minute)
        # Using /proc/loadavg is lighter than uptime/awk
        read load_1 _ < /proc/loadavg
        load_int=${load_1%%.*} # Integer part
        
        # Threshold: If Load > Total Cores, system is busy
        core_limit=$(nproc)
        busy_limit=$(( core_limit + 2 )) # Slight buffer
        
        if [ "$load_int" -ge "$busy_limit" ]; then
            if [ "$state" != "YIELD" ]; then
                # Server is overloaded -> Lower priority significantly
                renice -n 15 -g "$pgid" >/dev/null 2>&1
                state="YIELD"
            fi
        else
            if [ "$state" != "NORMAL" ]; then
                # Server is fine -> Restore normal priority
                renice -n 0 -g "$pgid" >/dev/null 2>&1
                state="NORMAL"
            fi
        fi
        sleep 5
    done
}

print_header() {
    clear
    MY_IP=$(hostname -I | awk '{print $1}')
    echo -e "${BOLD_GREEN}==========================================${NC}"
    echo -e "${BOLD_GREEN}       ZTURBO - DEV OPTIMIZED ENGINE      ${NC}"
    echo -e "${BOLD_GREEN}==========================================${NC}"
    echo -e "👤 USER: ${BOLD_YELLOW}$REAL_USER${NC} | 🌐 IP: ${BOLD_MAGENTA}$MY_IP${NC} | 💾 MODE: $CURRENT_MODE"
    echo -e "------------------------------------------"
}

show_footer() {
    echo -e "\n${BOLD_CYAN}------------------------------------------${NC}"
    echo -e "$1"
    echo -e "${BOLD_CYAN}------------------------------------------${NC}"
    echo -n " 👉 INPUT > "
}
format_duration() { printf "%02dh:%02dm:%02ds" $(($1/3600)) $(($(( $1%3600 ))/60)) $(($1%60)); }
human_size() { numfmt --to=iec-i --suffix=B $1 2>/dev/null || echo "$1 B"; }

# Array untuk menyimpan multi-select
declare -a SELECTED_PATHS
declare -a SELECTED_NAMES

# --- 1. SOURCE MODULE (MULTI-SELECT) ---
select_source() {
    SELECTED_PATHS=()
    SELECTED_NAMES=()

    while true; do
        print_header
        echo -e "${BOLD_YELLOW}[ STEP 1 ] SELECT SOURCE LOCATION${NC}"
        mapfile -t mounts < <(mount | grep -E "type cifs|type nfs|type gpfs|type smb|on /mnt|on /media" | awk '{print $3 "|" $1}')
        echo -e " [0] 🏠 HOME DIR ($HOME)"
        echo -e " [1] 🌳 ROOT DIR (/)"
        i=2
        for line in "${mounts[@]}"; do
            path=$(echo "$line" | cut -d'|' -f1)
            src=$(echo "$line" | cut -d'|' -f2)
            echo -e " [$i] 📂 ${BOLD_MAGENTA}$path${NC}"
            echo -e "     └─ 🔗 Source: ${GREY}$src${NC}"
            ((i++))
        done
        show_footer "[#] Select | [R] Refresh | [Q] Quit"
        read pil || exit 1
        if [[ "${pil^^}" == "Q" ]]; then exit 0; fi
        if [[ "${pil^^}" == "R" ]]; then continue; fi
        if [ "$pil" == "0" ]; then NAV_PATH="$HOME"; elif [ "$pil" == "1" ]; then NAV_PATH="/"; elif [[ "$pil" =~ ^[0-9]+$ ]] && [ "$pil" -lt "$i" ]; then idx=$((pil-2)); l="${mounts[$idx]}"; NAV_PATH=$(echo "$l" | cut -d'|' -f1); else echo "Invalid!"; sleep 1; continue; fi

        MOUNT_ROOT="$NAV_PATH"
        BREAK_SRC=false
        
        while true; do
            print_header
            echo -e "${BOLD_YELLOW}[ BROWSE SOURCE ]${NC} ${BOLD_WHITE}$NAV_PATH${NC}"
            SEL_COUNT=${#SELECTED_PATHS[@]}
            if [ $SEL_COUNT -gt 0 ]; then
                echo -e "${BOLD_GREEN}✅ Selected Items: $SEL_COUNT${NC} (Type 'd' to Finish)"
            fi

            mapfile -t contents < <(\ls -1 -A --group-directories-first --color=never "$NAV_PATH" 2>/dev/null)
            count=1
            echo -e " ----------------------------------------"
            echo -e " [0] ✅ DONE / SELECT CURRENT FOLDER"
            echo -e " ----------------------------------------"
            
            for item in "${contents[@]}"; do
                fp="${NAV_PATH%/}/$item"
                IS_SELECTED=false
                for s in "${SELECTED_PATHS[@]}"; do if [[ "$s" == "$fp" ]]; then IS_SELECTED=true; break; fi; done
                if [ "$IS_SELECTED" = true ]; then MARK="[${BOLD_GREEN}*${NC}]"; else MARK="[ ]"; fi
                if [ -d "$fp" ]; then echo -e " $MARK [$count] 📁 ${BOLD_CYAN}$item/${NC}"; else echo -e " $MARK [$count] 📄 $item"; fi
                ((count++))
            done
            
            if [ "$NAV_PATH" == "$MOUNT_ROOT" ] || [ "$NAV_PATH" == "/" ]; then BACK_MSG="Back to Menu"; else BACK_MSG="Up One Level (..)"; fi
            show_footer "[#] Enter Folder | [S #] Toggle | [A] All | [C] Clear | [D] Done | [B] $BACK_MSG"
            read inp || exit 1
            
            if [[ "${inp^^}" == "Q" ]]; then exit 0; fi
            if [[ "${inp^^}" == "D" ]] || [[ "$inp" == "0" ]]; then
                if [ ${#SELECTED_PATHS[@]} -eq 0 ]; then SELECTED_PATHS+=("$NAV_PATH"); SELECTED_NAMES+=("Whole Folder"); fi
                BREAK_SRC=true; break
            fi
            if [[ "${inp^^}" == "B" ]]; then if [ "$NAV_PATH" == "$MOUNT_ROOT" ] || [ "$NAV_PATH" == "/" ]; then break; else NAV_PATH=$(dirname "$NAV_PATH"); continue; fi; fi
            if [[ "${inp^^}" == "A" ]]; then
                 for item in "${contents[@]}"; do
                    full_p="${NAV_PATH%/}/$item"
                    exists=false
                    for s in "${SELECTED_PATHS[@]}"; do if [[ "$s" == "$full_p" ]]; then exists=true; break; fi; done
                    if [ "$exists" = false ]; then SELECTED_PATHS+=("$full_p"); SELECTED_NAMES+=("$item"); fi
                 done
                 continue
            fi
            if [[ "${inp^^}" == "C" ]]; then
                SELECTED_PATHS=()
                SELECTED_NAMES=()
                continue
            fi
            if [[ "$inp" =~ ^[sS][[:space:]]*([0-9]+)$ ]]; then
                num="${BASH_REMATCH[1]}"
                if [ "$num" -lt "$count" ] && [ "$num" -gt 0 ]; then
                    idx=$((num-1)); item="${contents[$idx]}"; target="${NAV_PATH%/}/$item"
                    found_idx=-1
                    for i in "${!SELECTED_PATHS[@]}"; do if [[ "${SELECTED_PATHS[$i]}" == "$target" ]]; then found_idx=$i; break; fi; done
                    if [ $found_idx -ge 0 ]; then unset 'SELECTED_PATHS[found_idx]'; unset 'SELECTED_NAMES[found_idx]'; SELECTED_PATHS=("${SELECTED_PATHS[@]}"); SELECTED_NAMES=("${SELECTED_NAMES[@]}")
                    else SELECTED_PATHS+=("$target"); SELECTED_NAMES+=("$item"); fi
                fi
                continue
            fi
            if [[ "$inp" =~ ^[0-9]+$ ]] && [ "$inp" -lt "$count" ]; then
                idx=$((inp-1)); sel="${contents[$idx]}"; target="${NAV_PATH%/}/$sel"
                if [ -d "$target" ]; then NAV_PATH="$target"; else echo -e "${BOLD_RED}Use 's $inp' to select this file.${NC}"; sleep 1; fi
            fi
        done
        if [ "$BREAK_SRC" = true ]; then return 0; fi
    done
}

# --- 2. DESTINATION MODULE ---
select_dest() {
    while true; do
        print_header
        echo -e "${BOLD_YELLOW}[ STEP 2 ] SELECT DESTINATION${NC}"
        if [ ${#SELECTED_PATHS[@]} -gt 1 ]; then echo -e "Source: ${BOLD_CYAN}${SELECTED_PATHS[0]} ... and $((${#SELECTED_PATHS[@]}-1)) others${NC}"; else echo -e "Source: ${BOLD_CYAN}${SELECTED_PATHS[0]}${NC}"; fi
        echo -e "------------------------------------------"
        mapfile -t mounts < <(mount | grep -E "type cifs|type nfs|type gpfs|type smb|on /mnt|on /media" | awk '{print $3 "|" $1}')
        echo -e " [0] 🏠 HOME DIR ($HOME)"
        echo -e " [1] 🌳 ROOT DIR (/)"
        i=2
        for line in "${mounts[@]}"; do
            path=$(echo "$line" | cut -d'|' -f1)
            src=$(echo "$line" | cut -d'|' -f2)
            echo -e " [$i] 📂 ${BOLD_MAGENTA}$path${NC}"
            echo -e "     └─ 🔗 Source: ${GREY}$src${NC}"
            ((i++))
        done
        show_footer "[#] Select | [R] Refresh | [B] Back"
        read pil || exit 1
        if [[ "${pil^^}" == "Q" ]]; then exit 0; fi; if [[ "${pil^^}" == "B" ]]; then return 1; fi; if [[ "${pil^^}" == "R" ]]; then continue; fi
        if [ "$pil" == "0" ]; then NAV_PATH="$HOME"; elif [ "$pil" == "1" ]; then NAV_PATH="/"; elif [[ "$pil" =~ ^[0-9]+$ ]] && [ "$pil" -lt "$i" ]; then idx=$((pil-2)); l="${mounts[$idx]}"; NAV_PATH=$(echo "$l" | cut -d'|' -f1); else echo "Invalid!"; sleep 1; continue; fi

        MOUNT_ROOT="$NAV_PATH"
        BREAK_DEST=false
        while true; do
            print_header
            echo -e "${BOLD_YELLOW}[ BROWSE DESTINATION ]${NC} ${BOLD_WHITE}$NAV_PATH${NC}"
            mapfile -t contents < <(\ls -1 -A --group-directories-first --color=never "$NAV_PATH" 2>/dev/null)
            count=1
            echo -e " [0] ✅ ${BOLD_GREEN}SELECT THIS FOLDER${NC}"
            echo -e " ----------------------------------------"
            for item in "${contents[@]}"; do
                fp="${NAV_PATH%/}/$item"
                if [ -d "$fp" ]; then echo -e " [$count] 📁 ${BOLD_CYAN}$item/${NC}"; ((count++)); fi
            done
            
            if [ "$NAV_PATH" == "$MOUNT_ROOT" ] || [ "$NAV_PATH" == "/" ]; then BACK_MSG="Back to Menu"; else BACK_MSG="Up One Level (..)"; fi
            show_footer "[#] Enter Folder | [MK] New Folder | [0] Select Current | [B] $BACK_MSG"
            read inp || exit 1
            if [[ "${inp^^}" == "B" ]]; then if [ "$NAV_PATH" == "$MOUNT_ROOT" ] || [ "$NAV_PATH" == "/" ]; then break; else NAV_PATH=$(dirname "$NAV_PATH"); continue; fi; fi
            if [[ "$inp" == "0" ]]; then DEST_ROOT="$NAV_PATH"; BREAK_DEST=true; break; fi
            if [[ "${inp^^}" == "MK" ]]; then read -p "New Folder Name: " new_f; mkdir -p "$NAV_PATH/$new_f"; continue; fi
            if [[ "$inp" =~ ^[0-9]+$ ]] && [ "$inp" -lt "$count" ]; then
                mapfile -t only_folders < <(\ls -1 -d --group-directories-first "$NAV_PATH"/*/ 2>/dev/null)
                idx=$((inp-1)); sel=$(basename "${only_folders[$idx]}"); target="${NAV_PATH%/}/$sel"
                if [ -d "$target" ]; then NAV_PATH="$target"; fi
            fi
        done
        if [ "$BREAK_DEST" = true ]; then return 0; fi
    done
}

# --- ADAPTIVE THREAD CALCULATOR (ANTI-HANG) ---
calc_optimal_threads() {
    local mode="$1"
    local cores=$(nproc)
    local mem_total_mb=$(free -m | grep Mem | awk '{print $2}')
    
    # 1. RAM SAFETY GUARD (The "Anti-Hang" Factor)
    # Reserve 20% of RAM for OS/System, only use remaining 80% for threads.
    local mem_usable_mb=$(( mem_total_mb * 80 / 100 )) 
    
    # Estimate 60MB RAM usage per thread (Conservative estimate)
    local max_threads_ram=$(( mem_usable_mb / 60 ))
    [ $max_threads_ram -lt 2 ] && max_threads_ram=2
    
    local target_threads=1
    
    if [ "$mode" == "SAFE" ]; then
        # SAFE: Strict CPU limit (75% of Cores) to keep system responsive
        target_threads=$(awk -v c="$cores" 'BEGIN {printf "%.0f", c * 0.75}')
        [ $target_threads -lt 1 ] && target_threads=1
    else
        # TURBO: Aggressive I/O Over-provisioning
        # rsync is I/O bound, so we safely run more threads than cores.
        target_threads=$(( cores * 4 ))
        
        # HPC SCALING (For 100Gbps+ links):
        # If server has huge RAM (>64GB), we assume it can handle higher concurrency
        if [ $mem_total_mb -gt 64000 ]; then
             local boost_threads=$(( cores * 8 ))
             [ $boost_threads -gt $target_threads ] && target_threads=$boost_threads
        fi
    fi
    
    # 2. FINAL CUT-OFF
    # Always choose the LOWER value between CPU-Target and RAM-Limit.
    # This guarantees we never exhaust RAM, preventing server freeze.
    if [ $target_threads -gt $max_threads_ram ]; then
        target_threads=$max_threads_ram
    fi
    
    # 3. ABSOLUTE LIMIT (1024 for HPC)
    [ $target_threads -gt 1024 ] && target_threads=1024
    
    echo "$target_threads"
}

# --- MAIN LOGIC ---
STEP=1

while true; do
    if [ $STEP -eq 1 ]; then 
        select_source
        if [ ${#SELECTED_PATHS[@]} -eq 1 ]; then SUGGESTED_NAME=$(basename "${SELECTED_PATHS[0]}"); else SUGGESTED_NAME="Batch_Transfer_$(date +%H%M)"; fi
        SUB_FOLDER="$SUGGESTED_NAME"
        STEP=2
    fi
    if [ $STEP -eq 2 ]; then select_dest; if [ $? -eq 1 ]; then STEP=1; continue; fi; STEP=3; fi

    if [ $STEP -eq 3 ]; then
        # Initial calculation if not set manually
        if [ -z "$MANUAL_THREADS" ]; then
            THREADS=$(calc_optimal_threads "$CURRENT_MODE")
        fi
        
        if [ "$CURRENT_MODE" == "SAFE" ]; then 
            MODE_MSG="${BOLD_GREEN}SAFE${NC}"
        else 
            MODE_MSG="${BOLD_RED}TURBO (ADAPTIVE)${NC}"
        fi
        
        # FIX: Trailing Slash Logic
        # If user selected a single file as source, destination should NOT end with slash if we are renaming/targeting it
        # But actually, rsync handles dest folder fine.
        # The issue is likely how SUB_FOLDER is appended.
        
        if [ "$SUB_FOLDER" == "." ]; then 
            DEST="${DEST_ROOT%/}/"
        else 
            DEST="${DEST_ROOT%/}/$SUB_FOLDER"
            # Only append slash if it is intended as a directory
            if [ -d "${SELECTED_PATHS[0]}" ]; then
                DEST="$DEST/"
            fi
        fi
        
        print_header
        echo -e "${BOLD_YELLOW}[ FINAL CONFIRMATION ]${NC}"
        echo -e " [1] SOURCE  :"
        for s in "${SELECTED_PATHS[@]}"; do echo -e "     - $s"; done
        echo -e " [2] DEST    : $DEST_ROOT"
        echo -e " [3] FOLDER  : $SUB_FOLDER"
        echo -e " [4] THREADS : $THREADS ($MODE_MSG)"
        echo -e " [5] MODE    : $CURRENT_MODE"
        echo -e "------------------------------------------"
        echo -e " TARGET      : ${BOLD_GREEN}$DEST${NC}"
        echo -e "------------------------------------------"
        echo -e " ${BOLD_RED}⚠️  To START, Type 'OK' and Press Enter.${NC}"
        show_footer "Type 'OK' | [1-5] Edit | [MK] Create Folder | [B] Back"
        read k || exit 1
        if [[ "$k" == "OK" ]]; then break; fi
        case "${k^^}" in
            Q) exit 0 ;; B) STEP=2; continue ;; MK) read -p "Create folder in Dest: " new_sub; mkdir -p "$DEST_ROOT/$new_sub"; DEST_ROOT="$DEST_ROOT/$new_sub" ;; 
            1) select_source ;; 2) select_dest ;; 3) read -e -p "New Folder Name: " -i "$SUB_FOLDER" SUB_FOLDER ;; 
            4) read -p "Set Threads: " MANUAL_THREADS || exit 1; THREADS=$MANUAL_THREADS ;; 
            5) 
                [ "$CURRENT_MODE" == "SAFE" ] && CURRENT_MODE="TURBO" || CURRENT_MODE="SAFE"
                # Recalculate unless manual
                if [ -z "$MANUAL_THREADS" ]; then THREADS=$(calc_optimal_threads "$CURRENT_MODE"); fi
            ;; 
        esac
    fi
done

# --- EXECUTION ---
print_header
echo -e "\n${BOLD_CYAN}🚀 INITIALIZING TRANSFER...${NC}"

START_TIME=$(date +%s); START_DATE=$(date)
cat <<EOF > "$REPORT_TXT"
================================================================
              ZTURBO TRANSFER REPORT (DEV)
================================================================
JOB ID      : $JOB_ID
USER        : $REAL_USER
DATE        : $START_DATE
----------------------------------------------------------------
DESTINATION : $DEST
MODE        : $CURRENT_MODE (Threads: $THREADS)
SOURCES     :
EOF
for s in "${SELECTED_PATHS[@]}"; do echo " - $s" >> "$REPORT_TXT"; done
echo "================================================================" >> "$REPORT_TXT"
echo "LOGS START:" >> "$REPORT_TXT"

if [ ${#SELECTED_PATHS[@]} -gt 1 ]; then MON_SRC="${SELECTED_PATHS[0]}..++"; else MON_SRC="${SELECTED_PATHS[0]}"; fi
MON_START_TIME=$(date +%s)

# Initial Monitor File with CALC (Non-blocking UI)
echo "$$|$REAL_USER|$CURRENT_MODE|$MON_SRC|$DEST|CALC|$MON_START_TIME" > "$MONITOR_FILE"
chmod 666 "$MONITOR_FILE" 2>/dev/null

echo ">> Calculating Source Metadata (Background)..."
(
    CALC_BYTES=0
    for s in "${SELECTED_PATHS[@]}"; do
        sb=$(du -sb "$s" 2>/dev/null | cut -f1)
        CALC_BYTES=$((CALC_BYTES + sb))
    done
    # Update Monitor File with real size
    echo "$$|$REAL_USER|$CURRENT_MODE|$MON_SRC|$DEST|$CALC_BYTES|$MON_START_TIME" > "$MONITOR_FILE"
    # Save for main process
    echo "$CALC_BYTES" > "/tmp/zturbo_size_$$"
) &
PID_CALC=$!

if [ "$CURRENT_MODE" == "SAFE" ]; then PREFIX="nice -n 10 ionice -c 2 -n 7"; else PREFIX=""; fi

# Start Dynamic Governor (Adaptive Priority)
dynamic_governor &
GOV_PID=$!

if [ ${#SELECTED_PATHS[@]} -gt 1 ]; then
    if [ "$CURRENT_MODE" == "SAFE" ]; then
        echo ">> Multi-select detected. Using RSYNC (Safe Mode) for batch integrity."
        $PREFIX rsync -av --progress "${SELECTED_PATHS[@]}" "$DEST" >> "$REPORT_TXT" 2>&1
        EXIT_CODE=$?
    else
        echo ">> Multi-select detected. Running Parallel Engine (TURBO) for each item..."
        EXIT_CODE=0
        for s in "${SELECTED_PATHS[@]}"; do
            echo ">> Processing: $(basename "$s")" | tee -a "$REPORT_TXT"
            
            # HYBRID LOGIC: Use fpsync for folders, rsync for single files
            if [ -d "$s" ]; then
                $PREFIX fpsync -n $THREADS -f $FILES_PER_JOB -v \
                -o "-lptgoD --numeric-ids --no-compress --info=progress2" \
                "$s" "$DEST" >> "$REPORT_TXT" 2>&1
                RET=$?
            else
                # Single file -> Use RSYNC (Faster/Safer for single blob)
                $PREFIX rsync -av --progress "$s" "$DEST" >> "$REPORT_TXT" 2>&1
                RET=$?
            fi
            
            [ $RET -ne 0 ] && EXIT_CODE=1
        done
    fi
else
    if [ "$CURRENT_MODE" == "SAFE" ]; then 
        $PREFIX rsync -av --progress "${SELECTED_PATHS[0]}" "$DEST" >> "$REPORT_TXT" 2>&1
        EXIT_CODE=$?
    else 
        # SINGLE ITEM TURBO CHECK
        if [ -d "${SELECTED_PATHS[0]}" ]; then
            $PREFIX fpsync -n $THREADS -f $FILES_PER_JOB -v \
            -o "-lptgoD --numeric-ids --no-compress --info=progress2" \
            "${SELECTED_PATHS[0]}" "$DEST" >> "$REPORT_TXT" 2>&1
            EXIT_CODE=$?
        else
             # Single file in Turbo mode -> Fallback to rsync
             $PREFIX rsync -av --progress "${SELECTED_PATHS[0]}" "$DEST" >> "$REPORT_TXT" 2>&1
             EXIT_CODE=$?
        fi
    fi
fi

JOB_COMPLETED=true

# Retrieve Calculated Source Size (if background calc finished)
wait $PID_CALC
if [ -f "/tmp/zturbo_size_$$" ]; then
    SRC_BYTES=$(cat "/tmp/zturbo_size_$$")
    rm -f "/tmp/zturbo_size_$$"
else
    # Fallback if file missing (should not happen)
    SRC_BYTES=0
fi

echo -e "\n${BOLD_YELLOW}🔎 VERIFYING DATA INTEGRITY (PARALLEL CHECK)...${NC}"

# OPTIMIZATION: Parallel Calculation
calc_source() {
    T_BYTES=0; T_FILES=0
    for s in "${SELECTED_PATHS[@]}"; do
        b=$(du -sb "$s" 2>/dev/null | cut -f1); f=$(find "$s" -type f | wc -l)
        T_BYTES=$((T_BYTES + b)); T_FILES=$((T_FILES + f))
    done
    echo "$T_BYTES $T_FILES" > /tmp/dt_src_$$
}

calc_dest() {
    b=$(du -sb "$1" 2>/dev/null | cut -f1); f=$(find "$1" -type f | wc -l)
    echo "$b $f" > /tmp/dt_dest_$$
}

calc_source & 
PID_SRC=$!
calc_dest "$DEST" & 
PID_DEST=$!

wait $PID_SRC
wait $PID_DEST

read SRC_BYTES SRC_FILES < /tmp/dt_src_$$
read DEST_BYTES DEST_FILES < /tmp/dt_dest_$$
rm -f /tmp/dt_src_$$ /tmp/dt_dest_$$

if [ "$SRC_BYTES" -eq "$DEST_BYTES" ]; then SIZE_STATUS="MATCH ✅"; else SIZE_STATUS="MISMATCH ❌"; fi
if [ "$SRC_FILES" -eq "$DEST_FILES" ]; then FILE_STATUS="MATCH ✅"; else FILE_STATUS="MISMATCH ❌"; fi

if [ $EXIT_CODE -eq 0 ]; then 
    if [[ "$SIZE_STATUS" == *"MATCH"* ]] && [[ "$FILE_STATUS" == *"MATCH"* ]]; then FINAL_STATUS="SUCCESS (VERIFIED)"; else FINAL_STATUS="WARNING (MISMATCH)"; fi
else FINAL_STATUS="FAILED (Code: $EXIT_CODE)"; fi

END_TIME=$(date +%s); DURATION=$((END_TIME - START_TIME)); DUR_FMT=$(format_duration $DURATION)
cat <<EOF >> "$REPORT_TXT"

================================================================
                  RECONCILIATION REPORT
================================================================
METRIC         SOURCE            DESTINATION       STATUS
----------------------------------------------------------------
Total Bytes    $SRC_BYTES        $DEST_BYTES       $SIZE_STATUS
Total Files    $SRC_FILES              $DEST_FILES             $FILE_STATUS
----------------------------------------------------------------
Duration    : $DUR_FMT
Final Status: $FINAL_STATUS
================================================================
Report generated by ZTURBO v1.1 (Dev)
EOF

rm -f "$MONITOR_FILE"
echo -e "\n✅ ${BOLD_GREEN}COMPLETED!${NC} Report saved."
echo -e "Status: $FINAL_STATUS"

